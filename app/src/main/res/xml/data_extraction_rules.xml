<?xml version="1.0" encoding="utf-8"?>
<!--
  Controls cloud backup and device-to-device transfer on Android 12+.
  Once any <include> is present in a block, only explicitly included
  paths apply there, so each domain needs its own <include> before
  <exclude> entries under it mean anything.
-->
<data-extraction-rules>
    <cloud-backup>
        <include domain="sharedpref" path="." />
        <include domain="database" path="." />
        <exclude domain="database" path="vineos.db" />
        <exclude domain="database" path="vineos.db-shm" />
        <exclude domain="database" path="vineos.db-wal" />
        <include domain="file" path="." />
        <exclude domain="file" path="instances/" />
        <exclude domain="file" path="roms/" />
    </cloud-backup>
    <device-transfer>
        <!-- No includes in this block: default is include-everything, then exclude all -->
        <exclude domain="root" path="." />
    </device-transfer>
</data-extraction-rules>
