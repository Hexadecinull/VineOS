<?xml version="1.0" encoding="utf-8"?>
<!--
  Controls what gets backed up via Android Auto Backup (API 23+).
  Once any <include> is present, only explicitly included paths are
  backed up per domain, so each domain needs its own <include> before
  <exclude> entries under it mean anything.
-->
<full-backup-content>
    <include domain="sharedpref" path="." />

    <!-- Room database: instances are recreated by the user, not restored -->
    <include domain="database" path="." />
    <exclude domain="database" path="vineos.db" />
    <exclude domain="database" path="vineos.db-shm" />
    <exclude domain="database" path="vineos.db-wal" />

    <!-- VM instance data and downloaded ROMs: large, re-downloadable -->
    <include domain="file" path="." />
    <exclude domain="file" path="instances/" />
    <exclude domain="file" path="roms/" />
</full-backup-content>
